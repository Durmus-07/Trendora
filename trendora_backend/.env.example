NODE_ENV=development
PORT=3000

# Virgülle ayrılmış web istemcileri. Mobil istemciler Origin başlığı göndermez.
ALLOWED_ORIGINS=http://localhost:8080
JSON_BODY_LIMIT=256kb
REQUEST_WINDOW_MS=60000
REQUEST_LIMIT=120
TRENDORA_EVIDENCE_CACHE_TTL_MS=600000
TRENDORA_LOCAL_NEWS_LIMIT=3000

# Yenileme gibi yönetici işlemleri için uzun ve rastgele bir değer kullanın.
ADMIN_API_KEY=change-me

# AI özellikleri için gereklidir.
ENABLE_ANALYSIS=true
ENABLE_AI=false
ENABLE_PREMIUM_AI_SUMMARY=false
AI_PREMIUM_ONLY=true
OPENAI_API_KEY=
TRENDORA_ANALYSIS_MODEL=gpt-5-mini

ENABLE_NEWS_COLLECTOR=true
ENABLE_TREND_COLLECTOR=true
ENABLE_MARKET_COLLECTOR=true
ENABLE_TELEGRAM_COLLECTOR=false

# Telegram collector etkinleştirilecekse doldurun.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_SESSION=
PUBLIC_BASE_URL=http://localhost:3000
